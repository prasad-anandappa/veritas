# Leave everything blank to run in deterministic MOCK mode (offline demo,
# bundled fixture corpus + deterministic mock LLM). Fill in the keys to go
# LIVE — the same code paths run against the real services, no changes needed.

# Tavily — real-time web search + extraction. Get a key at https://tavily.com
TAVILY_API_KEY=

# Nebius Token Factory — open-model inference (OpenAI-compatible API).
# Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Aliases also accepted: TOKEN_FACTORY_API_KEY, TOKEN_FACTORY_BASE_URL, TOKEN_FACTORY_MODEL
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
